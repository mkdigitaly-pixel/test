# Скопируйте в .env (не коммитить)

TELEGRAM_BOT_TOKEN=

# Основной канал: свои посты + тизеры на Дзен (НЕ синхробот)
TELEGRAM_MAIN_CHANNEL_ID=@mariyaprodirect

# Отдельный канал: ТОЛЬКО полные статьи → @zen_sync_bot → Дзен
TELEGRAM_DZEN_CHANNEL_ID=@dzenkovaleva

VK_ACCESS_TOKEN=
VK_GROUP_ID=
# Для картинок к постам (vkhost.github.io → photos, wall, groups, offline)
VK_USER_TOKEN=

# Дзен: sync = TG → @zen_sync_bot (обложка + текст, как 7-errors)
# rss / both = дополнительно HTML-лента с полной разметкой
DZEN_PUBLISH_MODE=sync
DZEN_RSS_DRAFT=true
DZEN_RSS_SITE_URL=https://mkekspert.ru
DZEN_RSS_FEED_URL=https://mkekspert.ru/dzen-feed.xml
# Куда скопировать feed.xml на сервере (опционально)
DZEN_RSS_DEPLOY_PATH=
# Публичный URL обложек для RSS (raw GitHub или CDN на mkekspert.ru)
DZEN_COVER_BASE_URL=
# Уведомление в TG — только в канал БЕЗ @zen_sync_bot (иначе создаст пост без разметки)
DZEN_TG_NOTIFY=false
DZEN_TG_NOTIFY_CHANNEL=

DRY_RUN=true
# Расписание (schedule run): true = реальная публикация без ручного DRY_RUN=false
AUTO_PUBLISH=true
