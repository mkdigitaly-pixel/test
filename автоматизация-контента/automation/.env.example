# Скопируйте в .env (не коммитить)

TELEGRAM_BOT_TOKEN=

# Основной канал: свои посты + тизеры на Дзен (НЕ синхробот)
TELEGRAM_MAIN_CHANNEL_ID=@mariyaprodirect

# Отдельный канал: ТОЛЬКО короткие статьи ≤1024 зн. → @zen_sync_bot (опционально)
TELEGRAM_DZEN_CHANNEL_ID=@dzenkovaleva

VK_ACCESS_TOKEN=
VK_GROUP_ID=
# Для картинок к постам (vkhost.github.io → photos, wall, groups, offline)
VK_USER_TOKEN=

# --- Дзен: полный автомат через RSS ---
# auto = короткие через zen_sync, длинные через RSS (рекомендуется)
DZEN_PUBLISH_MODE=auto
# false = автопубликация в Дзене; true = черновик в Студии (нужен клик)
DZEN_RSS_DRAFT=false
# --- Дзен RSS: blog.mkekspert.ru (не Tilda), см. checklists/dzen-rss-tilda.md ---
DZEN_RSS_SITE_URL=https://blog.mkekspert.ru
DZEN_RSS_FEED_URL=https://blog.mkekspert.ru/dzen-feed.xml
DZEN_COVER_BASE_URL=https://blog.mkekspert.ru/covers
DZEN_RSS_DEPLOY_GIT=true
DZEN_RSS_DEPLOY_GH_PAGES=true
# После publish dzen — git push feed в ветку кода + gh-pages на blog
DZEN_RSS_DEPLOY_GIT=true
GITHUB_REPO=mkdigitaly-pixel/test
# Ожидание dzen_url перед тизерами (schedule сам повторяет pending-слоты)
DZEN_URL_POLL_BURST_MINUTES=15
DZEN_URL_POLL_INTERVAL_SEC=60
DZEN_URL_POLL_MAX_MINUTES=90
# Уведомление в TG (канал БЕЗ @zen_sync_bot)
DZEN_TG_NOTIFY=false
DZEN_TG_NOTIFY_CHANNEL=

DRY_RUN=true
# Расписание: true = реальная публикация по cron/таймеру агента
AUTO_PUBLISH=true
