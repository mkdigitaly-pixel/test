# Скопируйте в .env и заполните (файл .env в git не коммитить)

# --- Telegram (обязательно для публикации) ---
# Бот: @BotFather → /newbot → токен
TELEGRAM_BOT_TOKEN=

# Канал для статей → Дзен (публичный, с zen_sync_bot админом)
# Пример: @mariyaprodirect или -1001234567890
TELEGRAM_DZEN_CHANNEL_ID=

# Канал для тизеров (если отличается от DZEN; иначе оставьте пустым)
TELEGRAM_TEASER_CHANNEL_ID=

# --- VK (опционально) ---
VK_ACCESS_TOKEN=
VK_GROUP_ID=

# --- Режим ---
# dry_run=true — только показать, что уйдёт, без отправки
DRY_RUN=true
