# Скопируйте в .env (не коммитить)
# Инструкция: ../checklists/credentials.md

TELEGRAM_BOT_TOKEN=

# Основной канал: свои посты + тизеры на Дзен (НЕ синхробот)
TELEGRAM_MAIN_CHANNEL_ID=@mariyaprodirect

# Отдельный канал: ТОЛЬКО короткие статьи ≤1024 зн. → @zen_sync_bot (опционально)
TELEGRAM_DZEN_CHANNEL_ID=@dzenkovaleva

VK_ACCESS_TOKEN=
VK_GROUP_ID=
# Пользовательский ключ для обложек (не ключ сообщества). См. checklists/vk-photo-token.md
VK_USER_TOKEN=
# До этой даты VK только текстом — не трогаем user API / фото (flood cooldown)
VK_TEXT_ONLY_UNTIL=2026-10-19

# --- Tilda (API только чтение/экспорт, тариф Business) ---
# Настройки сайта → Экспорт → API
TILDA_PUBLIC_KEY=
TILDA_SECRET_KEY=
TILDA_PROJECT_ID=
# pageid страницы /razbor-direct (из URL редактора или getpageslist)
TILDA_PAGE_RAZBOR_ID=
# Логин/пароль Tilda сюда НЕ писать — API ими не пользуется

# --- Дзен: полный автомат через RSS ---
# auto = короткие через zen_sync, длинные через RSS (рекомендуется)
DZEN_PUBLISH_MODE=auto
# false = автопубликация в Дзене; true = черновик в Студии (нужен клик)
DZEN_RSS_DRAFT=false
# --- Дзен RSS: blog.mkekspert.ru (не Tilda), см. checklists/dzen-rss-tilda.md ---
DZEN_RSS_SITE_URL=https://blog.mkekspert.ru
DZEN_RSS_FEED_URL=https://blog.mkekspert.ru/dzen-feed.xml
DZEN_COVER_BASE_URL=https://blog.mkekspert.ru/covers
DZEN_RSS_DEPLOY_GIT=true
DZEN_RSS_DEPLOY_GH_PAGES=true
GITHUB_REPO=mkdigitaly-pixel/test
# Вебмастер / Дзен: meta yandex-verification на blog
WEBMASTER_YANDEX_VERIFICATION=
# DZEN_YANDEX_VERIFICATION=
DZEN_BLOG_METRIKA_ID=97606312

DZEN_URL_POLL_BURST_MINUTES=15
DZEN_URL_POLL_INTERVAL_SEC=60
DZEN_URL_POLL_MAX_MINUTES=90
DZEN_TG_NOTIFY=false
DZEN_TG_NOTIFY_CHANNEL=

DRY_RUN=true
AUTO_PUBLISH=true

# --- SEO позиции (опционально, xmlriver.com) ---
# SEO_SERP_PROVIDER=xmlriver
# SEO_SERP_USER=
# SEO_SERP_KEY=
# SEO_SERP_REGION=213

# --- Яндекс (опционально, позже) ---
# YANDEX_WEBMASTER_TOKEN=
# YANDEX_METRIKA_TOKEN=
# YANDEX_METRIKA_COUNTER_ID=97606312

# --- Обложки ---
# COVER_STYLE=modern_neon_3d
# COVER_NO_TEXT=1
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux-1.1-pro
